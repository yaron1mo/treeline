  },
  "line": {
    "hp": 20,
    "notes": "Each attacker that reaches the rear edge deals its line_damage. Passengers still inside a vehicle add 1 each. At 0 HP the field is lost.",
    "proposed": [
      "hp"
    ]
  },
  "pathfinding": {
    "notes": "Route cost per cell = travel time + safety_weight x expected damage. Wave 1 is mostly about speed; from wave 2 safety comes first, speed second.",
