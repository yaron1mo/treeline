    "machine_gun": "machine guns",
    "sniper": "sniper team",
    "explosive": "mortar, grenades, mines",
    "fpv": "our FPV drones",
    "atgm": "anti-tank guided missiles",
    "air_defence": "mobile air-defence group",
    "radar": "detects aviation; does no damage"
