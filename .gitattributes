* text=auto

# Unity text-serialised assets: merge as plain text
*.unity   text eol=lf linguist-language=yaml
*.prefab  text eol=lf linguist-language=yaml
*.asset   text eol=lf linguist-language=yaml
*.mat     text eol=lf linguist-language=yaml
*.anim    text eol=lf linguist-language=yaml
*.controller text eol=lf linguist-language=yaml
*.meta    text eol=lf linguist-language=yaml
*.cs      text eol=lf

# Large binaries -> Git LFS
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text

# These two charts were committed as normal files (2026-11-24); keep them out of LFS so clones are clean.
docs/balance/mistral/attacker-cost/*.png !filter !diff !merge binary

# Review images and GIFs of the agents stay out of LFS (2026-11-27), so that every agent and Claude can read them
# from git. Keep them small (pixel art, GIFs under 2 MB).
docs/design/visual/** !filter !diff !merge binary
